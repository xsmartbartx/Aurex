# AUREX configuration. Copy to .env and adjust. Never commit the real .env.

# --- Deployment ----------------------------------------------------------------------------------
# local | self_hosted | cloud. Cloud mode starts new organizations on Community and enables billing.
AUREX_DEPLOYMENT_MODE=self_hosted
AUREX_ENVIRONMENT=production
# Public hostname served by the proxy (production overlay) and the URL used in links and redirects.
AUREX_DOMAIN=terminal.example.com
AUREX_PUBLIC_URL=https://terminal.example.com
ACME_EMAIL=ops@example.com
# Long random value, e.g. `openssl rand -hex 32`. Required in production.
AUREX_SECRET_KEY=
AUREX_COOKIE_SECURE=true
# false = only invitations (and the emails below) can create accounts.
AUREX_ALLOW_SIGNUP=true
# Accounts with these emails administer the platform (JSON list) and may sign up even when sign-up is
# closed. Required for an administrator in production; elsewhere, when empty, the first account to sign up
# becomes administrator.
AUREX_PLATFORM_ADMIN_EMAILS=["ops@example.com"]
# Behind Cloudflare with an origin that accepts only Cloudflare: CF-Connecting-IP. Empty otherwise.
AUREX_CLIENT_IP_HEADER=

# --- Database --------------------------------------------------------------------------------------
AUREX_DB_USER=aurex
AUREX_DB_PASSWORD=
AUREX_DB_NAME=aurex

# --- Data sources ----------------------------------------------------------------------------------
# SEC EDGAR requires automated clients to name a contact: "Company Name contact@company.com".
AUREX_SEC_USER_AGENT=
AUREX_INGEST_ENABLED=true

# --- AI ------------------------------------------------------------------------------------------
# Without a key the offline evidence engine answers inside the deployment.
AUREX_ANTHROPIC_API_KEY=
AUREX_AI_MODEL=claude-opus-5-5
AUREX_AI_EFFORT=medium
AUREX_AI_MAX_STEPS=8

# --- Email (invitations) -----------------------------------------------------------------------------
AUREX_SMTP_HOST=
AUREX_SMTP_PORT=587
AUREX_SMTP_USER=
AUREX_SMTP_PASSWORD=
AUREX_SMTP_FROM=

# --- Billing (cloud mode) ------------------------------------------------------------------------------
AUREX_STRIPE_SECRET_KEY=
AUREX_STRIPE_WEBHOOK_SECRET=
# JSON maps of plan -> Stripe price id, and plan -> label shown on the pricing page.
AUREX_STRIPE_PRICES={}
AUREX_PLAN_PRICE_LABELS={}

# --- Operator details shown on public pages --------------------------------------------------------------
AUREX_OPERATOR_NAME=
AUREX_SALES_CONTACT=
AUREX_SUPPORT_CONTACT=
